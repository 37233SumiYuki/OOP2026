@model List<SelfOrderSystem.Models.CartItem>

@{
    ViewData["Title"] = "カート";
    var total = Model.Sum(x => x.LineTotal);
}

<h2>カート</h2>

@if (Model.Count == 0) {
    <div class="alert alert-info">
        カートは空です
    </div>

    <a asp-controller="Menu"
       asp-action="Index"
       class="btn btn-primary">
        メニューへ戻る
    </a>
} else {
    @foreach (var item in Model) {
        <div class="card mb-3">
            <div class="card-body">

                <strong>@item.ProductName</strong><br />

                @item.UnitPrice.ToString("N0") 円 × @item.Quantity

                <div class="mt-2">
                    <strong>
                        @item.LineTotal.ToString("N0") 円
                    </strong>
                </div>

                <div class="mt-3">

                    <form asp-controller="Cart"
                          asp-action="Update"
                          method="post"
                          class="d-inline">

                        <input type="hidden"
                               name="productId"
                               value="@item.ProductId" />

                        <input type="number"
                               name="quantity"
                               value="@item.Quantity"
                               min="1"
                               class="form-control d-inline"
                               style="width:100px" />

                        <button type="submit"
                                class="btn btn-warning">
                            変更
                        </button>
                    </form>

                    <form asp-controller="Cart"
                          asp-action="Remove"
                          method="post"
                          class="d-inline ms-2">

                        <input type="hidden"
                               name="productId"
                               value="@item.ProductId" />

                        <button type="submit"
                                class="btn btn-danger">
                            削除
                        </button>
                    </form>

                </div>

            </div>
        </div>

        @if (Model.Any()) {
            <a class="btn btn-success btn-lg w-100"
               asp-controller="Orders" asp-action="Checkout">
                注文内容を確認する
            </a>
        }

    }

    <div class="alert alert-success">
        <h4>合計 @total.ToString("N0") 円</h4>
    </div>
}